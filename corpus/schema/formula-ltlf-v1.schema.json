{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-ix.github.io/tl-syntax/schema/formula-ltlf-v1.schema.json",
  "title": "tl-syntax LTLf finite-trace formula document v1",
  "description": "Structural Draft 7 contract for the admitted LTLf vocabulary (ADR-044, ADR-045): constants, propositions, Boolean operators, interval-free future, globally, until, release, strong_next and weak_next. There is no bare next. LtlfFormulaDocument::from_json_bytes is mandatory for canonical bytes, topology, graph depth, identities and the typed refusal of interval-carrying, past and W/M nodes.",
  "x-tl-syntax-semantic-reader": "LtlfFormulaDocument::from_json_bytes",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "semantic_profile", "root", "nodes"],
  "properties": {
    "schema_version": { "const": "tl-syntax.formula-ltlf/v1" },
    "semantic_profile": { "const": "mltl.ltlf-finite-trace/v1" },
    "root": { "$ref": "#/$defs/id" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "id": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": { "start": { "$ref": "#/$defs/id" }, "end": { "$ref": "#/$defs/id" } }
    },
    "node": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"],
          "properties": { "kind": { "enum": ["false", "true"] }, "span": { "$ref": "#/$defs/span" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "proposition"],
          "properties": { "kind": { "const": "proposition" }, "proposition": { "$ref": "#/$defs/id" }, "span": { "$ref": "#/$defs/span" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "operand"],
          "properties": { "kind": { "enum": ["not", "future", "globally", "strong_next", "weak_next"] }, "operand": { "$ref": "#/$defs/id" }, "span": { "$ref": "#/$defs/span" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "left", "right"],
          "properties": { "kind": { "enum": ["and", "or", "implies", "equivalent", "until", "release"] }, "left": { "$ref": "#/$defs/id" }, "right": { "$ref": "#/$defs/id" }, "span": { "$ref": "#/$defs/span" } } }
      ]
    }
  }
}
