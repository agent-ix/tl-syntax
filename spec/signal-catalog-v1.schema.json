{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-ix.github.io/tl-syntax/schema/signal-catalog-v1.schema.json",
  "title": "tl-syntax signal catalog v1",
  "description": "Structural Draft 7 contract. The tl-syntax SignalCatalogDocument reader is mandatory for UTF-8 byte limits, identity ordering, unique names, domain bounds, and binding-target semantics.",
  "x-tl-syntax-semantic-reader": "SignalCatalogDocument::from_json_bytes",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "signals", "bindings"],
  "properties": {
    "schema_version": { "const": "tl-syntax.signal-catalog/v1" },
    "signals": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/signal" }
    },
    "bindings": {
      "type": "array",
      "maxItems": 100000,
      "items": { "$ref": "#/$defs/binding" }
    }
  },
  "$defs": {
    "id": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "domain"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "domain": { "$ref": "#/$defs/domain" }
      }
    },
    "domain": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "boolean" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "minimum", "maximum"],
          "properties": {
            "kind": { "const": "integer" },
            "minimum": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 },
            "maximum": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "minimum_coefficient", "maximum_coefficient", "scale"],
          "properties": {
            "kind": { "const": "fixed_decimal" },
            "minimum_coefficient": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 },
            "maximum_coefficient": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 },
            "scale": { "type": "integer", "minimum": 0, "maximum": 18 }
          }
        }
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposition", "signal"],
      "properties": {
        "proposition": { "$ref": "#/$defs/id" },
        "signal": { "$ref": "#/$defs/id" }
      }
    }
  }
}
